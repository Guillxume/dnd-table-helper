# Copiez ce fichier vers .env puis remplissez les valeurs.
# Le fichier .env ne doit jamais être partagé ni versionné.

# Jeton du bot (portail développeur Discord, onglet Bot)
DISCORD_TOKEN=

# Identifiant de l'application (portail développeur Discord)
DISCORD_CLIENT_ID=

# Identifiant de votre serveur Discord (mode développeur activé, clic droit sur le serveur)
DISCORD_GUILD_ID=

# Clé de l'API Claude (Console Claude, facturation séparée de l'abonnement Claude Pro)
ANTHROPIC_API_KEY=

# Optionnel : modèle utilisé pour le rappel (défaut : claude-haiku-5-5)
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optionnel : emplacement de la base SQLite (défaut : ./data/jdr.sqlite)
# DB_PATH=./data/jdr.sqlite

# Optionnel : surveillance. URL appelée toutes les 5 minutes tant que le bot est connecté à Discord
# (par exemple l'URL de ping d'un contrôle healthchecks.io, qui prévient si les appels s'arrêtent).
# HEARTBEAT_URL=

# Optionnel : adresse du site de la table (création de personnage, fiches). Les tableaux de bord
# et le message d'accueil affichent alors un bouton vers le site. Republier les tableaux de bord
# existants avec /campagne panneau pour y faire apparaître le bouton.
# SITE_URL=https://table.example.com
