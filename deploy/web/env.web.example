# /srv/jdr-helper/.env.web : configuration du site (chmod 600, propriétaire deploy).
# Sa présence active les services du site (profil Compose « web ») dans update.sh.
# Générer chaque secret avec : openssl rand -hex 32 (hexadécimal : sûr dans une URL).

SITE_DOMAIN=table.example.com

# Base PostgreSQL du site (bibliothèque d'illustrations, comptes).
POSTGRES_USER=jdr
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-16
POSTGRES_DB=jdr_library
# Recopier le mot de passe ci-dessus.
DATABASE_URL=postgresql://jdr:remplacer-par-openssl-rand-hex-16@db:5432/jdr_library

BETTER_AUTH_SECRET=remplacer-par-openssl-rand-hex-32
BETTER_AUTH_URL=https://table.example.com

# Stockage des images (SeaweedFS, réseau interne uniquement).
S3_ENDPOINT=http://storage:8333
S3_REGION=us-east-1
S3_BUCKET=jdr-library
S3_ACCESS_KEY_ID=remplacer-par-openssl-rand-hex-10
S3_SECRET_ACCESS_KEY=remplacer-par-openssl-rand-hex-20
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=40

# Discord : mêmes identifiants d'application et de serveur que le bot (.env), plus le secret OAuth2.
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Assistant de création (idées d'histoire, conseil de sorts), rédigé par Claude Haiku comme sur Discord.
# Facultatif : sans clé, les boutons n'apparaissent pas. Clé de la console Anthropic ; une clé
# dédiée au site permet de suivre sa consommation et de la révoquer sans toucher au bot.
ANTHROPIC_API_KEY=
# Demandes par joueur et par heure (protège le crédit prépayé).
ASSISTANT_HOURLY_LIMIT=12
