{
  "name": "jdr-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot Discord d'aide aux campagnes de JDR : rappel de séance, puis aide au MJ et fiche de personnage",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx --env-file=.env src/index.ts",
    "deploy-commands": "tsx --env-file=.env src/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "srd:verify": "tsx scripts/srd/verify.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
