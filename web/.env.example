# ─────────────────────────────────────────────────────────────────────────────
# Modèle de configuration. Aucune valeur ci-dessous n'est un vrai secret.
#
# Développement : copier en `.env`        (cp .env.example .env)
# Production    : copier en `.env.production` et ne garder que la section
#                 « Production » (docker-compose.prod.yml calcule le reste).
#
# Générer des secrets : openssl rand -hex 32
# Utiliser des valeurs hexadécimales pour POSTGRES_PASSWORD : le mot de passe
# est inséré tel quel dans une URL de connexion.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=jdr
POSTGRES_PASSWORD=remplacer-par-openssl-rand-hex-16
POSTGRES_DB=jdr_library
# Port exposé sur la machine en développement (5432 est souvent déjà pris).
POSTGRES_HOST_PORT=5434
# Recopier le mot de passe ci-dessus dans les deux URL (pas d'interpolation).
DATABASE_URL=postgresql://jdr:remplacer-par-openssl-rand-hex-16@127.0.0.1:5434/jdr_library
# Base dédiée aux tests (créée automatiquement par docker-compose.yml) : elle est vidée par les tests.
TEST_DATABASE_URL=postgresql://jdr:remplacer-par-openssl-rand-hex-16@127.0.0.1:5434/jdr_library_test

# ── Authentification ─────────────────────────────────────────────────────────
# 32 caractères minimum. Le changer déconnecte toutes les sessions.
BETTER_AUTH_SECRET=remplacer-par-openssl-rand-hex-32
# URL publique exacte de l'application (sert à la vérification d'origine des requêtes).
BETTER_AUTH_URL=http://localhost:3000

# ── Stockage objet compatible S3 ─────────────────────────────────────────────
# En développement : SeaweedFS lancé par docker-compose.yml.
S3_ENDPOINT=http://127.0.0.1:8334
S3_HOST_PORT=8334
S3_REGION=us-east-1
S3_BUCKET=jdr-library
# Bucket dédié aux tests, vidé par les tests.
S3_TEST_BUCKET=jdr-library-test
S3_ACCESS_KEY_ID=remplacer-par-openssl-rand-hex-10
S3_SECRET_ACCESS_KEY=remplacer-par-openssl-rand-hex-20
# true pour SeaweedFS, MinIO, Garage ; false pour AWS S3.
S3_FORCE_PATH_STYLE=true

# ── Import ───────────────────────────────────────────────────────────────────
# Taille maximale d'un fichier importé, en Mo (1 à 200).
UPLOAD_MAX_MB=40

# ── Espace des joueurs (jdr-helper) ─────────────────────────────────────────
# Base SQLite du bot, partagée. En local : une copie de travail, jamais la base du serveur.
JDR_DB_PATH=../data/jdr.sqlite
# Feuille officielle (PDF à champs) ; chemin absolu ou relatif à web/.
SHEET_TEMPLATE=../ref/DD5-eFeuillePersoDD5.pdf
# Serveur Discord de la table et application du bot (connexion des joueurs).
# Sans DISCORD_GUILD_ID, seul l'atelier du MJ fonctionne.
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Assistant de création (idées d'histoire, conseil de sorts). Facultatif.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
ASSISTANT_HOURLY_LIMIT=12

# ── Production (docker-compose.prod.yml) ─────────────────────────────────────
# Variables lues dans .env.production : POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DB, BETTER_AUTH_SECRET, BETTER_AUTH_URL (https://…), S3_BUCKET,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, UPLOAD_MAX_MB et APP_HOST_PORT.
# DATABASE_URL et S3_ENDPOINT sont construits par le fichier compose.
# Port local publié pour le reverse proxy (défaut 3000) :
# APP_HOST_PORT=3000
